[Unit]
Description=Video Matrix Script Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/video-matrix
EnvironmentFile=/etc/video-matrix/env
ExecStart=/opt/video-matrix/.venv/bin/python services/script_service_local.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
